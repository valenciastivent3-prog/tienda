/* FASE 4 · ACCESIBILIDAD, RENDIMIENTO Y CURSOR OPCIONAL. Para quitarlo: borra css/final.css y js/final.js de index.html. */
:focus-visible{outline:2px solid var(--accent);outline-offset:3px;box-shadow:0 0 0 5px rgba(34,211,238,.18)}
.skip{position:fixed;left:12px;top:-70px;z-index:1000;padding:10px 16px;border-radius:10px;background:var(--accent);color:#031018;font-weight:800;transition:top .2s}
.skip:focus{top:12px}
/* equipos modestos (4 núcleos o menos / 2 GB): quita lo más pesado, la tienda se ve igual de bien */
.lite header.scrolled,.lite .toast,.lite dialog::backdrop{backdrop-filter:none;-webkit-backdrop-filter:none}
.lite #hud-grid,.lite .hero-x>.core,.lite .hero-x>.scan,.lite .hero::after{display:none}
/* pausa las animaciones del hero cuando no se ve */
.hero-x.off *,.hero-x.off::after{animation-play-state:paused!important}
/* cursor personalizado (solo PC, se puede apagar con el botón ◎) */
html.cur-on,html.cur-on *{cursor:none!important}
html.cur-on input,html.cur-on textarea{cursor:text!important}
#cur-dot,#cur-ring{position:fixed;left:0;top:0;pointer-events:none;z-index:1000;border-radius:50%}
#cur-dot{width:6px;height:6px;margin:-3px;background:var(--accent);box-shadow:0 0 10px var(--accent)}
#cur-ring{width:36px;height:36px;margin:-18px;border:1.5px solid rgba(34,211,238,.6);transition:width .25s,height .25s,margin .25s,background .25s,border-color .25s}
#cur-ring.hot{width:54px;height:54px;margin:-27px;background:rgba(34,211,238,.12);border-color:var(--accent2)}
html:not(.cur-on) #cur-dot,html:not(.cur-on) #cur-ring{opacity:0}
#cur-tg{position:fixed;left:12px;bottom:12px;z-index:150;width:36px;height:36px;border-radius:50%;border:1px solid var(--line);background:rgba(11,16,32,.8);color:var(--accent);font-size:1.1rem;cursor:pointer}
#cur-tg[aria-pressed=false]{color:var(--muted);opacity:.7}
@media (max-width:760px),(hover:none){#cur-tg,#cur-dot,#cur-ring{display:none}}
